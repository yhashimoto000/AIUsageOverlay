# ────────────────────────────────────────────────────────────────
# .NET ビルド成果物
# ────────────────────────────────────────────────────────────────

# ビルド出力ディレクトリ
bin/
obj/

# 発行出力ディレクトリ（dotnet publish -o publish/ の出力先）
# exe はビルド成果物のため追跡しない。リリース配布は release.yml で GitHub Release に zip 添付する。
publish/

# build-release.bat が生成する配布用 zip
AIUsageOverlay_*.zip

# NuGet パッケージキャッシュ（packages/ 以下に展開される場合）
packages/
*.nupkg
*.snupkg

# ────────────────────────────────────────────────────────────────
# Visual Studio / IDE
# ────────────────────────────────────────────────────────────────

# Visual Studio ソリューションユーザー設定
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# JetBrains Rider
.idea/
*.DotSettings.user

# ────────────────────────────────────────────────────────────────
# ランタイム・一時ファイル
# ────────────────────────────────────────────────────────────────

# アプリが %TEMP% に保存する WebView2 プロファイルは追跡しない
# （ユーザーのローカルデータであり、リポジトリに含めない）

# Windows サムネイルキャッシュ
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS DS_Store（共同作業者対策）
.DS_Store

# ────────────────────────────────────────────────────────────────
# ログ・設定（ユーザー固有）
# ────────────────────────────────────────────────────────────────

# アプリが %AppData% に保存する設定ファイルはリポジトリに含めない
# settings.json はユーザー環境ごとに異なるため

# テスト結果
TestResults/
*.trx
coverage/

# ────────────────────────────────────────────────────────────────
# GitHub Actions キャッシュ（ローカルテスト用 act ツールなど）
# ────────────────────────────────────────────────────────────────
.cache/
