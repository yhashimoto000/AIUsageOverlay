<Window x:Class="AIUsageOverlay.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Claude ログイン - Usage Overlay"
        Width="920" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C1C">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 案内テキスト行 -->
            <RowDefinition Height="Auto"/>
            <!-- ナビゲーションバー行 -->
            <RowDefinition Height="Auto"/>
            <!-- エラーバナー行（通常は高さ0、エラー時に表示） -->
            <RowDefinition x:Name="ErrorRow" Height="0"/>
            <!-- WebView2 行 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 案内メッセージ（x:Name でコードビハインドから動的に設定する） -->
        <TextBlock x:Name="GuideMessageText"
                   Grid.Row="0"
                   Text="ログインしてください。ログイン完了後、このウィンドウを閉じると自動で使用量が更新されます。"
                   Foreground="#AAAAAA"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="12,10,12,8"/>

        <!-- ナビゲーションバー: リダイレクト時に戻るために使う -->
        <Grid Grid.Row="1" Background="#252525" Height="36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 戻るボタン -->
            <Button x:Name="BackButton" Grid.Column="0"
                    Content="◀" Width="36" Height="36"
                    Background="Transparent" Foreground="#AAAAAA"
                    BorderThickness="0" FontSize="14" Cursor="Hand"
                    ToolTip="前のページに戻る"
                    Click="BackButton_Click"/>
            <!-- 更新ボタン -->
            <Button x:Name="ReloadButton" Grid.Column="1"
                    Content="↺" Width="36" Height="36"
                    Background="Transparent" Foreground="#AAAAAA"
                    BorderThickness="0" FontSize="16" Cursor="Hand"
                    ToolTip="ページを更新する"
                    Click="ReloadButton_Click"/>
            <!-- URL 表示欄 -->
            <TextBlock x:Name="UrlBar" Grid.Column="2"
                       Foreground="#888888" FontSize="11"
                       VerticalAlignment="Center" Margin="6,0,8,0"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="現在のURL"/></Grid>

        <!-- エラーバナー: WebView2 描画失敗時に表示するフォールバック UI -->
        <Border x:Name="ErrorBanner"
                Grid.Row="2"
                Background="#2A1A1A"
                Padding="12,8"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ErrorMessageText"
                           Text="ブラウザの表示に失敗しました。"
                           Foreground="#FF8888"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <!-- システムブラウザで開くフォールバックボタン -->
                <Button x:Name="OpenBrowserButton"
                        Content="ブラウザで claude.ai を開く"
                        Click="OpenBrowserButton_Click"
                        Background="#3A2A2A"
                        Foreground="#FFAAAA"
                        BorderBrush="#FF6666"
                        BorderThickness="1"
                        Padding="8,4"
                        FontSize="12"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- WebView2 ブラウザ -->
        <wv2:WebView2 x:Name="LoginWebView"
                      Grid.Row="3"/>
    </Grid>
</Window>
