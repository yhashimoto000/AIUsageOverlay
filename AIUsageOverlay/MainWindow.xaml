<Window x:Class="AIUsageOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIUsageOverlay"
        mc:Ignorable="d"
        Title="AI Usage Overlay"
        Width="460"
        SizeToContent="Height"
        MinWidth="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.ContextMenu>
        <ContextMenu Background="#2A2A2A" BorderBrush="#484848" Foreground="White">
            <MenuItem Header="設定(_S)" Click="Settings_Click" Background="#2A2A2A" Foreground="White"/>
            <MenuItem Header="ログイン - Claude(_L)" Click="Login_Click" Background="#2A2A2A" Foreground="White"/>
            <MenuItem Header="ログイン - GitHub(_G)" Click="GitHubLogin_Click" Background="#2A2A2A" Foreground="White"/>
            <MenuItem Header="ログイン - OpenAI(_O)" Click="CodexLogin_Click" Background="#2A2A2A" Foreground="White"/>
            <MenuItem Header="セッションリセット(_R)" Click="ResetSession_Click" Background="#2A2A2A" Foreground="White"/>
            <Separator Background="#484848"/>
            <MenuItem Header="非表示にする(_H)" Click="Hide_Click" Background="#2A2A2A" Foreground="White"/>
            <Separator Background="#484848"/>
            <MenuItem Header="終了(_X)" Click="Exit_Click" Background="#2A2A2A" Foreground="White"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Border Background="#1C1C1C" CornerRadius="8" BorderBrush="#3D3D3D" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="5" Text="{Binding StatusText}" Foreground="#555555"
                       FontSize="9" HorizontalAlignment="Right" Margin="0,0,10,4"/>

            <Rectangle Grid.Row="1" Height="1" Fill="#2A2A2A" Margin="10,0"
                       Visibility="{Binding GitHubSectionVisibility}"/>
            <Rectangle Grid.Row="3" Height="1" Fill="#2A2A2A" Margin="10,0"
                       Visibility="{Binding CodexSectionVisibility}"/>

            <!-- Row 0: Claude -->
            <Grid Grid.Row="0" Margin="14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{Binding SessionPercent}" Maximum="100"
                                     Height="11" Foreground="#FF8C00" VerticalAlignment="Center"
                                     Style="{StaticResource RoundProgressBarStyle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SessionPercentText}"
                                   Foreground="#FF8C00" FontSize="15" FontWeight="Bold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="セッション" Foreground="#888888" FontSize="11"/>
                        <TextBlock Grid.Column="2" Text="{Binding SessionRemainingText}" Foreground="#888888" FontSize="11"/>
                    </Grid>
                </Grid>
                <Rectangle Grid.Column="1" Width="1" Fill="#404040" Margin="0,3"/>
                <Grid Grid.Column="2" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="WeeklyIndicatorDot" Width="10" Height="10" Fill="#4CAF50"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="WeeklyPercentBlock" Text="{Binding WeeklyPercentText}"
                                   Foreground="#4CAF50" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="週間" Foreground="#888888" FontSize="11"/>
                        <TextBlock Grid.Column="2" Text="{Binding WeeklyRemainingText}" Foreground="#888888" FontSize="11"/>
                    </Grid>
                </Grid>
                <Button x:Name="RefreshButton" Grid.Column="3" Width="22" Height="22"
                        Margin="8,0,0,0" VerticalAlignment="Center" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" ToolTip="今すぐ更新" Click="Refresh_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BB" Background="Transparent" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BB" Property="Background" Value="#333333"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BB" Property="Background" Value="#444444"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="↺" FontSize="16" Foreground="#888888"/>
                </Button>
            </Grid>

            <!-- Row 2: GitHub Copilot -->
            <Grid Grid.Row="2" Margin="14,6,14,6" Visibility="{Binding GitHubSectionVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{Binding GitHubSeatsPercent}" Maximum="100"
                                     Height="11" Foreground="#58A6FF" VerticalAlignment="Center"
                                     Visibility="{Binding GitHubOrgBarVisibility}"
                                     Style="{StaticResource RoundProgressBarStyle}"/>
                        <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#58A6FF"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Visibility="{Binding GitHubIndividualDotVisibility}"/>
                        <TextBlock Grid.Column="1" Text="{Binding GitHubSeatsPercentText}"
                                   Foreground="#58A6FF" FontSize="15" FontWeight="Bold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding GitHubOrgBarVisibility}"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="GitHub Copilot" Foreground="#888888" FontSize="11"/>
                        <TextBlock Grid.Column="2" Text="{Binding GitHubSeatsText}"
                                   Foreground="#888888" FontSize="11"
                                   Visibility="{Binding GitHubOrgBarVisibility}"/>
                    </Grid>
                </Grid>
                <Rectangle Grid.Column="1" Width="1" Fill="#404040" Margin="0,3"/>
                <Grid Grid.Column="2" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding GitHubStatusText}"
                               Foreground="#58A6FF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="{Binding GitHubUserText}"
                               Foreground="#888888" FontSize="11"/>
                </Grid>
            </Grid>

            <!-- Row 4: Codex / OpenAI -->
            <Grid Grid.Row="4" Margin="14,6,14,6" Visibility="{Binding CodexSectionVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{Binding CodexUsagePercent}" Maximum="100"
                                     Height="11" Foreground="#10A37F" VerticalAlignment="Center"
                                     Visibility="{Binding CodexBarVisibility}"
                                     Style="{StaticResource RoundProgressBarStyle}"/>
                        <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#10A37F"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Visibility="{Binding CodexDotVisibility}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CodexUsagePercentText}"
                                   Foreground="#10A37F" FontSize="15" FontWeight="Bold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding CodexBarVisibility}"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="OpenAI / Codex" Foreground="#888888" FontSize="11"/>
                        <TextBlock Grid.Column="2" Text="{Binding CodexDetailText}"
                                   Foreground="#888888" FontSize="11"/>
                    </Grid>
                </Grid>
                <Rectangle Grid.Column="1" Width="1" Fill="#404040" Margin="0,3"/>
                <Grid Grid.Column="2" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding CodexStatusText}"
                               Foreground="#10A37F" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="{Binding CodexSubText}"
                               Foreground="#888888" FontSize="11"/>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>
