<Window x:Class="AIUsageOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIUsageOverlay"
        mc:Ignorable="d"
        Title="AI Usage Overlay"
        Width="460"
        SizeToContent="Height"
        MinWidth="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!--
        右クリックメニュー:
        セッションリセット・設定・終了 の操作を提供する
    -->
    <Window.ContextMenu>
        <ContextMenu Background="#2A2A2A" BorderBrush="#484848" Foreground="White">
            <MenuItem Header="設定(_S)" Click="Settings_Click"
                      Background="#2A2A2A" Foreground="White"/>
            <MenuItem Header="ログイン - Claude(_L)" Click="Login_Click"
                      Background="#2A2A2A" Foreground="White"/>
            <MenuItem Header="ログイン - GitHub(_G)" Click="GitHubLogin_Click"
                      Background="#2A2A2A" Foreground="White"/>
            <MenuItem Header="セッションリセット(_R)" Click="ResetSession_Click"
                      Background="#2A2A2A" Foreground="White"/>
            <Separator Background="#484848"/>
            <!-- トレイに隠す（× ボタンと同じ動作） -->
            <MenuItem Header="非表示にする(_H)" Click="Hide_Click"
                      Background="#2A2A2A" Foreground="White"/>
            <Separator Background="#484848"/>
            <MenuItem Header="終了(_X)" Click="Exit_Click"
                      Background="#2A2A2A" Foreground="White"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!--
        最外枠 Border:
        - Background="#1C1C1C" でダークテーマの背景を設定する
        - CornerRadius="8" で丸角にする
        - BorderBrush="#3D3D3D" で微細な縁取りを付ける
    -->
    <Border Background="#1C1C1C"
            CornerRadius="8"
            BorderBrush="#3D3D3D"
            BorderThickness="1">

        <!--
            メインレイアウトグリッド:
            列 0: セッションセクション（広め）
            列 1: 縦区切り線（1px）
            列 2: 週間セクション（狭め）
        -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Claude セクション行 -->
                <RowDefinition Height="Auto"/>
                <!-- Claude / GitHub 区切り線（GitHub 表示時のみ高さを持つ） -->
                <RowDefinition Height="Auto"/>
                <!-- GitHub Copilot セクション行（非表示時は高さ 0） -->
                <RowDefinition Height="Auto"/>
                <!-- ステータスバー行 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- ステータスバー（最終更新時刻 or エラー） -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusText}"
                   Foreground="#555555"
                   FontSize="9"
                   HorizontalAlignment="Right"
                   Margin="0,0,10,4"/>

        <!-- GitHub Copilot セクション（PAT 未設定時は Collapsed） -->
        <Grid Grid.Row="2"
              Margin="14,6,14,6"
              Visibility="{Binding GitHubSectionVisibility}">

            <Grid.ColumnDefinitions>
                <!-- シート数プログレスバー or ステータスドット -->
                <ColumnDefinition Width="5*"/>
                <!-- 縦区切り線 -->
                <ColumnDefinition Width="Auto"/>
                <!-- ユーザー/シート情報 -->
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================================
                 左列: GitHub Copilot ラベル + プログレスバー（組織プラン）
                 =================================================== -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 行 0: プログレスバー行（組織）or ステータスドット（個人） -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!--
                        組織シート使用率プログレスバー（ブルー）:
                        組織データなし時は Collapsed → ステータスドットを表示
                    -->
                    <ProgressBar Grid.Column="0"
                                 Value="{Binding GitHubSeatsPercent}"
                                 Maximum="100"
                                 Height="11"
                                 Foreground="#58A6FF"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding GitHubOrgBarVisibility}"
                                 Style="{StaticResource RoundProgressBarStyle}"/>

                    <!-- 個人プラン用ステータスドット（組織データあり時は Collapsed） -->
                    <Ellipse Grid.Column="0"
                             Width="10" Height="10"
                             Fill="#58A6FF"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Visibility="{Binding GitHubIndividualDotVisibility}"/>

                    <!-- シート使用率テキスト（例: "80%"）-->
                    <TextBlock Grid.Column="1"
                               Text="{Binding GitHubSeatsPercentText}"
                               Foreground="#58A6FF"
                               FontSize="15"
                               FontWeight="Bold"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding GitHubOrgBarVisibility}"/>
                </Grid>

                <!-- 行 2: "GitHub Copilot" ラベル + シート数テキスト -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="GitHub Copilot"
                               Foreground="#888888"
                               FontSize="11"/>

                    <!-- 組織: "8/10 シート" / 個人: 非表示 -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding GitHubSeatsText}"
                               Foreground="#888888"
                               FontSize="11"
                               Visibility="{Binding GitHubOrgBarVisibility}"/>
                </Grid>
            </Grid>

            <!-- 縦区切り線 -->
            <Rectangle Grid.Column="1"
                       Width="1"
                       Fill="#404040"
                       Margin="0,3"/>

            <!-- ===================================================
                 右列: ユーザー情報 / ステータス
                 =================================================== -->
            <Grid Grid.Column="2" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- GitHub ステータステキスト（例: "Connected" or エラー） -->
                <TextBlock Grid.Row="0"
                           Text="{Binding GitHubStatusText}"
                           Foreground="#58A6FF"
                           FontSize="13"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <!-- ログインユーザー名（例: "@yhashimoto"） -->
                <TextBlock Grid.Row="2"
                           Text="{Binding GitHubUserText}"
                           Foreground="#888888"
                           FontSize="11"/>
            </Grid>
        </Grid>

        <!-- Claude / GitHub 区切り線（GitHub 表示時のみ） -->
        <Rectangle Grid.Row="1"
                   Height="1"
                   Fill="#2A2A2A"
                   Margin="10,0"
                   Visibility="{Binding GitHubSectionVisibility}"/>

        <Grid Grid.Row="0" Margin="14,8">
            <Grid.ColumnDefinitions>
                <!-- セッションセクション: 週間より広いスペースを確保する -->
                <ColumnDefinition Width="5*"/>
                <!-- 縦区切り線 -->
                <ColumnDefinition Width="Auto"/>
                <!-- 週間セクション -->
                <ColumnDefinition Width="3*"/>
                <!-- 更新ボタン -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================================
                 左列: セッションセクション
                 行 0: オレンジ色プログレスバー + 使用率テキスト
                 行 1: スペーサー (4px)
                 行 2: "セッション" ラベル + 残り時間テキスト
                 =================================================== -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 行 0: プログレスバー行 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <!-- バー部分: 利用可能な幅を全て使う -->
                        <ColumnDefinition Width="*"/>
                        <!-- パーセンテージテキスト: 内容に合わせた幅 -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!--
                        セッション プログレスバー（オレンジ）:
                        - Value を SessionPercent (0〜100) にバインドする
                        - Foreground="#FF8C00" でオレンジ色を指定する
                        - RoundProgressBarStyle で丸角スタイルを適用する
                    -->
                    <ProgressBar Grid.Column="0"
                                 Value="{Binding SessionPercent}"
                                 Maximum="100"
                                 Height="11"
                                 Foreground="#FF8C00"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource RoundProgressBarStyle}"/>

                    <!--
                        セッション使用率テキスト（例: "75%"）:
                        オレンジ色・太字で目立たせる
                    -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding SessionPercentText}"
                               Foreground="#FF8C00"
                               FontSize="15"
                               FontWeight="Bold"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- 行 2: ラベル行（"セッション" と 残り時間） -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- "セッション" ラベル -->
                    <TextBlock Grid.Column="0"
            