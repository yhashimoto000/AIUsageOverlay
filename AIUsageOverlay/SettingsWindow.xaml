<Window x:Class="AIUsageOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="設定 - AI Usage Overlay"
        Width="400" Height="370"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1C1C1C"
        Foreground="White">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- タイトル -->
            <RowDefinition Height="*"/>     <!-- 設定項目 -->
            <RowDefinition Height="Auto"/>  <!-- ボタン -->
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock Grid.Row="0"
                   Text="設定"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <!-- 設定項目 -->
        <StackPanel Grid.Row="1">

            <!-- ── 更新間隔 ── -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="更新間隔（秒）"
                           Foreground="#AAAAAA"
                           FontSize="12"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="RefreshIntervalTextBox"
                         Background="#2E2E2E"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="#555555"
                         BorderThickness="1"
                         Padding="8,6"
                         FontSize="14"
                         Width="100"
                         HorizontalAlignment="Left"
                         ToolTip="デフォルト: 60（秒）"/>
            </StackPanel>

            <!-- ── GitHub Copilot ── -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="GitHub Copilot"
                           Foreground="#58A6FF"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>
                <CheckBox x:Name="GitHubCopilotCheckBox"
                          Content="GitHub Copilot の使用状況を表示する"
                          Foreground="White"
                          FontSize="13"
                          Cursor="Hand">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="CheckBorderGH"
                                                    Width="16" Height="16"
                                                    Background="#2E2E2E"
                                                    BorderBrush="#555555"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0">
                                                <TextBlock x:Name="CheckMarkGH"
                                                           Text="✓"
                                                           Foreground="#58A6FF"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed"/>
                                            </Border>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CheckMarkGH" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="CheckBorderGH" Property="BorderBrush" Value="#58A6FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <TextBlock Text="有効にした後、右クリック → 「GitHub ログイン」からログインしてください"
                           Foreground="#555555"
                           FontSize="10"
                           Margin="24,4,0,0"/>
            </StackPanel>

            <!-- ── スタートアップ登録 ── -->
            <StackPanel>
                <CheckBox x:Name="StartupCheckBox"
                          Content="Windows 起動時に自動で起動する"
                          Foreground="White"
                          FontSize="13"
                          Cursor="Hand">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                    