<Window x:Class="AIUsageOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="設定 - AI Usage Overlay"
        Width="620" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1A1A1D"
        Foreground="White">

    <!--
        デザイン刷新（設定 1d: サイドバーナビ + トグルスイッチ + セグメントコントロール）。
        TabControl を廃止し、左サイドバー（全般/表示項目/外観/通知）でコンテンツパネルを切り替える。
    -->

    <Window.Resources>
        <!-- ナビ選択（RadioButton.IsChecked）→ コンテンツパネルの表示切替に使う標準コンバータ -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ラベル・本文・ヒントの共通スタイル -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9AA2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="HintLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6B73"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 角丸ダークテキストボックス（背景 #232327・枠 #3A3A40・角丸6） -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#232327" BorderBrush="#3A3A40" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,6" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            トグルスイッチ（CheckBox 再テンプレート）: 38×21・角丸11・OFF #2E2E33 / ON #FF8C00・ノブ16 白。
            Content は表示しない（ラベルは行レイアウト側の TextBlock で置く）。
        -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="38" Height="21" CornerRadius="10.5"
                                Background="#2E2E33">
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF8C00"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- サイドバーのナビ項目（RadioButton・角丸7pxピル） -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" CornerRadius="7" Padding="10,8" Background="Transparent">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                       FontSize="12" Foreground="#9A9AA2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#1F1F23"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#26262B"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                                <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- セグメントコントロールの各セグメント（RadioButton・選択時 #FF8C00 背景 / #111 文字） -->
        <Style x:Key="SegmentItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Seg" CornerRadius="6" Padding="12,5" Background="Transparent">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                       FontSize="11" Foreground="#9A9AA2" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Seg" Property="Background" Value="#FF8C00"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="#111111"/>
                                <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- フッターボタン共通（角丸7・padding 8,20） -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Background="{TemplateBinding Background}"
                                Padding="20,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== サイドバー ===== -->
        <Border Grid.Column="0" Background="#141416" BorderBrush="#26262B" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,16">
                <TextBlock DockPanel.Dock="Top" Text="設定" FontSize="14" FontWeight="Bold"
                           Foreground="#F0F0F2" Margin="10,0,10,14"/>
                <TextBlock x:Name="VersionLabel" DockPanel.Dock="Bottom" Text="AI Usage Overlay"
                           FontSize="9" Foreground="#55555C" Margin="10,0,10,0"/>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavGeneral"    Content="全般"     Style="{StaticResource NavItem}"
                                 GroupName="Nav" IsChecked="True"/>
                    <RadioButton x:Name="NavDisplay"    Content="表示項目" Style="{StaticResource NavItem}"
                                 GroupName="Nav"/>
                    <RadioButton x:Name="NavAppearance" Content="外観"     Style="{StaticResource NavItem}"
                                 GroupName="Nav"/>
                    <RadioButton x:Name="NavNotify"     Content="通知"     Style="{StaticResource NavItem}"
                                 GroupName="Nav"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== コンテンツ ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <Grid Margin="24,20">

                    <!-- ============ 全般 ============ -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=NavGeneral, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="更新間隔（秒）" Style="{StaticResource SectionLabel}"/>
                            <TextBox x:Name="RefreshIntervalTextBox" Style="{StaticResource DarkTextBox}"
                                     Width="100" HorizontalAlignment="Left"
                                     ToolTip="デフォルト: 30（秒）。5 以上を指定"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="適応更新間隔（放置時に自動で間隔を延長）" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="OFF のとき常に上の更新間隔で更新します。ON では操作直後は短く、放置・非表示・電源制約時は長くなります。"
                                           Style="{StaticResource HintLabel}"/>
                            </StackPanel>
                            <CheckBox x:Name="AdaptiveRefreshCheckBox" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Windows 起動時に自動で起動する" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="レジストリ（HKCU\...\Run）に登録します" Style="{StaticResource HintLabel}"/>
                            </StackPanel>
                            <CheckBox x:Name="StartupCheckBox" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </Grid>

                        <Border BorderBrush="#303036" BorderThickness="0,1,0,0" Margin="0,0,0,18"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="自動で更新を確認する" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="GitHub Releases の公開情報を24時間ごとに確認します。利用データは送信しません。"
                                           Style="{StaticResource HintLabel}"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoUpdateCheckBox" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </Grid>

                        <StackPanel>
                            <TextBlock Text="バージョン情報" Style="{StaticResource SectionLabel}"/>
                            <DockPanel LastChildFill="False">
                                <TextBlock x:Name="CurrentVersionTextBlock" DockPanel.Dock="Left"
                                           Text="現在のバージョン: --"
                                           Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                                <Button x:Name="CheckUpdatesButton" DockPanel.Dock="Right"
                                        Content="今すぐ確認" Style="{StaticResource FlatButton}"
                                        Background="#26262B" Foreground="#D4D4D8"
                                        Click="CheckUpdatesNow_Click"/>
                            </DockPanel>
                            <TextBlock x:Name="UpdateCheckStatusTextBlock"
                                       Style="{StaticResource HintLabel}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ============ 表示項目 ============ -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=NavDisplay, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="GitHub Copilot の使用状況を表示する" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="有効後、右クリック → ログイン - GitHub からログインしてください"
                                           Style="{StaticResource HintLabel}"/>
                            </StackPanel>
                            <CheckBox x:Name="GitHubCopilotCheckBox" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Codex の使用制限を表示する" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="有効後、右クリック → ログイン - Codex からログインしてください"
                                           Style="{StaticResource HintLabel}"/>
                            </StackPanel>
                            <CheckBox x:Name="CodexCheckBox" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </Grid>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="リセット時刻の表示形式" Style="{StaticResource SectionLabel}"/>
                            <Border Background="#232327" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ResetRelative" Content="相対（残り 1時間13分）"
                                                 Style="{StaticResource SegmentItem}" GroupName="Reset" IsChecked="True"/>
                                    <RadioButton x:Name="ResetAbsolute" Content="絶対（16:00 リセット）"
                                                 Style="{StaticResource SegmentItem}" GroupName="Reset"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="ペース行（予定比・枯渇予測）を表示する" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="OFF のとき計算もスキップします。" Style="{StaticResource HintLabel}"/>
                            </StackPanel>
                            <CheckBox x:Name="PaceEnabledCheckBox" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="スパークライン（使用率推移）を表示する" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="取得した使用率%をアプリが自己記録し、直近の推移を折れ線で描きます。"
                                           Style="{StaticResource HintLabel}"/>
                            </StackPanel>
                            <CheckBox x:Name="ShowSparklineCheckBox" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </Grid>
                    </StackPanel>

                    <!-- ============ 外観 ============ -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=NavAppearance, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="オーバーレイ表示形式" Style="{StaticResource SectionLabel}"/>
                            <Border Background="#232327" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="OverlayLayoutList"    Content="縦積み"
                                                 Style="{StaticResource SegmentItem}" GroupName="Layout" IsChecked="True"/>
                                    <RadioButton x:Name="OverlayLayoutCompact" Content="コンパクト⇔詳細"
                                                 Style="{StaticResource SegmentItem}" GroupName="Layout"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="縦積み=1a（スパークライン付き）／ コンパクト⇔詳細=1b（クリックで展開）"
                                       Style="{StaticResource HintLabel}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="トレイアイコン形式" Style="{StaticResource SectionLabel}"/>
                            <Border Background="#232327" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TrayRing"    Content="リング"   Style="{StaticResource SegmentItem}"
                                                 GroupName="Tray" IsChecked="True"/>
                                    <RadioButton x:Name="TrayDualBar" Content="2段バー"  Style="{StaticResource SegmentItem}"
                                                 GroupName="Tray"/>
                                    <RadioButton x:Name="TrayDonut"   Content="ドーナツ" Style="{StaticResource SegmentItem}"
                                                 GroupName="Tray"/>
                                    <RadioButton x:Name="TrayNumeric" Content="数字"     Style="{StaticResource SegmentItem}"
                                                 GroupName="Tray"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="色の閾値（%）" Style="{StaticResource SectionLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#FF8C00" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="注意" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="CautionThresholdTextBox" Style="{StaticResource DarkTextBox}"
                                         Width="60" ToolTip="この値以上でオレンジ（既定 50）"/>
                                <Ellipse Width="8" Height="8" Fill="#F44336" VerticalAlignment="Center" Margin="20,0,6,0"/>
                                <TextBlock Text="警告" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="WarningThresholdTextBox" Style="{StaticResource DarkTextBox}"
                                         Width="60" ToolTip="この値以上で赤（既定 80）"/>
                            </StackPanel>
                            <TextBlock Text="注意% は警告% 未満で指定してください（CodexBar 既定は 70/80/90）"
                                       Style="{StaticResource HintLabel}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="バー上に閾値マーカーを表示する"
                                       Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox x:Name="ShowThresholdMarkersCheckBox" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </Grid>

                        <StackPanel>
                            <TextBlock x:Name="OpacityLabel" Text="オーバーレイ不透明度: 100%"
                                       Style="{StaticResource SectionLabel}"/>
                            <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0"
                                    Width="240" HorizontalAlignment="Left"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Foreground="#FF8C00"
                                    ValueChanged="OpacitySlider_ValueChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ============ 通知 ============ -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=NavNotify, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="通知を有効にする"
                                       Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox x:Name="NotificationsEnabledCheckBox" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </Grid>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="通知閾値（カンマ区切り、例: 70, 90）" Style="{StaticResource SectionLabel}"/>
                            <TextBox x:Name="NotificationThresholdsTextBox" Style="{StaticResource DarkTextBox}"
                                     Width="200" HorizontalAlignment="Left"
                                     ToolTip="0〜100 の整数をカンマ区切りで。既定 70, 90"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="リセット完了を通知する"
                                       Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox x:Name="NotifyOnResetCheckBox" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="100% 到達（上限）を通知する"
                                       Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox x:Name="NotifyOnExhaustedCheckBox" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </Grid>

                        <TextBlock Text="※ Windows の「フォーカスアシスト（応答不可）」設定中は通知が表示されないことがあります。"
                                   Style="{StaticResource HintLabel}"/>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- ===== フッター ===== -->
            <Border Grid.Row="1" BorderBrush="#26262B" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14">
                    <Button Content="キャンセル" Style="{StaticResource FlatButton}"
                            Background="#26262B" Foreground="#D4D4D8" Margin="0,0,10,0"
                            Click="Cancel_Click"/>
                    <Button Content="保存" Style="{StaticResource FlatButton}"
                            Background="#FF8C00" Foreground="#111111" FontWeight="Bold"
                            Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
