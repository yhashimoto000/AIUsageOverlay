<Window x:Class="AIUsageOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="設定 - AI Usage Overlay"
        Width="400" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1C1C1C"
        Foreground="White">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="設定" FontSize="18" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">

            <!-- 更新間隔 -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="更新間隔（秒）" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="RefreshIntervalTextBox"
                         Background="#2E2E2E" Foreground="White" CaretBrush="White"
                         BorderBrush="#555555" BorderThickness="1" Padding="8,6"
                         FontSize="14" Width="100" HorizontalAlignment="Left"
                         ToolTip="デフォルト: 30（秒）"/>
            </StackPanel>

            <!-- GitHub Copilot -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="GitHub Copilot" Foreground="#58A6FF" FontSize="13"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox x:Name="GitHubCopilotCheckBox"
                          Content="GitHub Copilot の使用状況を表示する"
                          Foreground="White" FontSize="13" Cursor="Hand">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="CBorderGH" Width="16" Height="16"
                                                    Background="#2E2E2E" BorderBrush="#555555"
                                                    BorderThickness="1" CornerRadius="3"
                                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock x:Name="CMarkGH" Text="&#10003;"
                                                           Foreground="#58A6FF" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="Collapsed"/>
                                            </Border>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CMarkGH" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="CBorderGH" Property="BorderBrush" Value="#58A6FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <TextBlock Text="有効後、右クリック → ログイン - GitHub からログインしてください"
                           Foreground="#555555" FontSize="10" Margin="24,4,0,0"/>
            </StackPanel>

            <!-- OpenAI / Codex -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="OpenAI / Codex" Foreground="#10A37F" FontSize="13"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox x:Name="CodexCheckBox"
                          Content="OpenAI / Codex の使用状況を表示する"
                          Foreground="White" FontSize="13" Cursor="Hand">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="CBorderOAI" Width="16" Height="16"
                                                    Background="#2E2E2E" BorderBrush="#555555"
                                                    BorderThickness="1" CornerRadius="3"
                                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock x:Name="CMarkOAI" Text="&#10003;"
                                                           Foreground="#10A37F" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="Collapsed"/>
                                            </Border>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CMarkOAI" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="CBorderOAI" Property="BorderBrush" Value="#10A37F"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <TextBlock Text="有効後、右クリック → ログイン - OpenAI からログインしてください"
                           Foreground="#555555" FontSize="10" Margin="24,4,0,0"/>
            </StackPanel>

            <!-- スタートアップ登録 -->
            <StackPanel>
                <CheckBox x:Name="StartupCheckBox"
                          Content="Windows 起動時に自動で起動する"
                          Foreground="White" FontSize="13" Cursor="Hand">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="CBorderSU" Width="16" Height="16"
                                                    Background="#2E2E2E" BorderBrush="#555555"
                                                    BorderThickness="1" CornerRadius="3"
                                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock x:Name="CMarkSU" Text="&#10003;"
                                                           Foreground="#FF8C00" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="Collapsed"/>
                                            </Border>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CMarkSU" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="CBorderSU" Property="BorderBrush" Value="#FF8C00"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <TextBlock Text="レジストリ（HKCU\...\Run）に登録します"
                           Foreground="#555555" FontSize="10" Margin="24,4,0,0"/>
            </StackPanel>

        </StackPanel>

        <!-- ボタン行 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" Width="90" Height="34" Margin="0,0,10,0"
                    Background="#333333" Foreground="White" BorderBrush="#555555"
                    BorderThickness="1" Cursor="Hand" Click="Cancel_Click"/>
            <Button Content="保存" Width="90" Height="34"
                    Background="#FF8C00" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Cursor="Hand" Click="Save_Click"/>
        </StackPanel>

    </Grid>
</Window>
