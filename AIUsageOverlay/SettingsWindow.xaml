<Window x:Class="AIUsageOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="設定 - AI Usage Overlay"
        Width="400" Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1C1C1C"
        Foreground="White">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- タイトル -->
            <RowDefinition Height="*"/>     <!-- 設定項目 -->
            <RowDefinition Height="Auto"/>  <!-- ボタン -->
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock Grid.Row="0"
                   Text="設定"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <!-- 設定項目 -->
        <StackPanel Grid.Row="1">

            <!-- ── 更新間隔 ── -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="更新間隔（秒）"
                           Foreground="#AAAAAA"
                           FontSize="12"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="RefreshIntervalTextBox"
                         Background="#2E2E2E"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="#555555"
                         BorderThickness="1"
                         Padding="8,6"
                         FontSize="14"
                         Width="100"
                         HorizontalAlignment="Left"
                         ToolTip="デフォルト: 60（秒）"/>
            </StackPanel>

            <!-- ── GitHub Copilot ── -->
            <StackPanel Margin="0,0,0,20">
                <!-- セクションヘッダー -->
                <TextBlock Text="GitHub Copilot"
                           Foreground="#58A6FF"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <!-- PAT 入力 -->
                <TextBlock Text="Personal Access Token（PAT）"
                           Foreground="#AAAAAA"
                           FontSize="12"
                           Margin="0,0,0,4"/>
                <PasswordBox x:Name="GitHubPatBox"
                             Background="#2E2E2E"
                             Foreground="White"
                             CaretBrush="White"
                             BorderBrush="#555555"
                             BorderThickness="1"
                             Padding="8,6"
                             FontSize="13"
                             ToolTip="ghp_xxx 形式のトークン（必要なスコープ: read:user, read:org）"/>
                <TextBlock Text="設定しない場合は GitHub Copilot セクションを非表示にします"
                           Foreground="#555555"
                           FontSize="10"
                           Margin="0,4,0,12"/>

                <!-- 組織名入力 -->
                <TextBlock Text="組織名（任意）"
                           Foreground="#AAAAAA"
                           FontSize="12"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="GitHubOrgTextBox"
                         Background="#2E2E2E"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="#555555"
                         BorderThickness="1"
                         Padding="8,6"
                         FontSize="13"
                         ToolTip="シート使用状況を表示したい GitHub 組織名（省略可）"/>
                <TextBlock Text="組織管理者権限が必要です。個人プランの場合は空のままにしてください"
                           Foreground="#555555"
                           FontSize="10"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ── スタートアップ登録 ── -->
            <StackPanel>
                <CheckBox x:Name="StartupCheckBox"
                          Content="Windows 起動時に自動で起動する"
                          Foreground="White"
                          FontSize="13"
                          Cursor="Hand">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- カスタムチェックボックス（オレンジアクセント） -->
                                            <Border x:Name="CheckBorder"
                                                    Width="16" Height="16"
                                                    Background="#2E2E2E"
                                                    BorderBrush="#555555"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0">
                                                <TextBlock x:Name="CheckMark"
                                                           Text="✓"
                                                           Foreground="#FF8C00"
                                                           FontSize="11"
        