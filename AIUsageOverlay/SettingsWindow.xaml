<Window x:Class="AIUsageOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="設定 - Claude Usage Overlay"
        Width="360" Height="290"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1C1C1C"
        Foreground="White">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- タイトル -->
            <RowDefinition Height="*"/>     <!-- 設定項目 -->
            <RowDefinition Height="Auto"/>  <!-- ボタン -->
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock Grid.Row="0"
                   Text="設定"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <!-- 設定項目 -->
        <StackPanel Grid.Row="1">

            <!-- ── 更新間隔 ── -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="更新間隔（秒）"
                           Foreground="#AAAAAA"
                           FontSize="12"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="RefreshIntervalTextBox"
                         Background="#2E2E2E"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="#555555"
                         BorderThickness="1"
                         Padding="8,6"
                         FontSize="14"
                         Width="100"
                         HorizontalAlignment="Left"
                         ToolTip="デフォルト: 60（秒）"/>
            </StackPanel>

            <!-- ── スタートアップ登録 ── -->
            <StackPanel>
                <CheckBox x:Name="StartupCheckBox"
                          Content="Windows 起動時に自動で起動する"
                          Foreground="White"
                          FontSize="13"
                          Cursor="Hand">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- カスタムチェックボックス（オレンジアクセント） -->
                                            <Border x:Name="CheckBorder"
                                                    Width="16" Height="16"
                                                    Background="#2E2E2E"
                                                    BorderBrush="#555555"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0">
                                                <TextBlock x:Name="CheckMark"
                                                           Text="✓"
                                                           Foreground="#FF8C00"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="Collapsed"/>
                                            </Border>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#FF8C00"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <TextBlock Text="レジストリ（HKCU\...\Run）に登録します"
                           Foreground="#555555"
                           FontSize="10"
                           Margin="24,4,0,0"/>
            </StackPanel>

        </StackPanel>

        <!-- ボタン行 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">

            <Button Content="キャンセル"
                    Width="90" Height="34"
                    Margin="0,0,10,0"
                    Background="#333333"
                    Foreground="White"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="Cancel_Click"/>

            <Button Content="保存"
                    Width="90" Height="34"
                    Background="#FF8C00"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="Save_Click"/>
        </StackPanel>

    </Grid>
</Window>
