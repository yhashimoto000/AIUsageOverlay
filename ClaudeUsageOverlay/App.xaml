<Application
    x:Class="ClaudeUsageOverlay.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ClaudeUsageOverlay"
    StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!--
            ========================================================
            丸角プログレスバー 共通スタイル
            ========================================================
            使い方: Style="{StaticResource RoundProgressBarStyle}"
            Foreground="色" で塗りつぶし色を指定する
            Background で未使用トラックの色を指定する
        -->
        <Style x:Key="RoundProgressBarStyle" TargetType="ProgressBar">
            <!--  トラック背景色（未使用部分）  -->
            <Setter Property="Background" Value="#2E2E2E" />
            <!--  枠線なし  -->
            <Setter Property="BorderThickness" Value="0" />
            <!--  デフォルト高さ  -->
            <Setter Property="Height" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <!--
                        ControlTemplate の構成:
                        1. 外枠 Border: 丸角 + ClipToBounds でインジケータをクリップする
                        2. PART_Track Grid: WPF 規約上必須の名前付きグリッド
                        3. PART_Indicator Rectangle: WPF が Value に応じて Width を自動計算する
                    -->
                    <ControlTemplate TargetType="ProgressBar">
                        <!--  ClipToBounds="True" でインジケータの角を丸くクリップする  -->
                        <Border
                            Background="{TemplateBinding Background}"
                            ClipToBounds="True"
                            CornerRadius="5">
                            <!--  PART_Track: WPF ProgressBar が参照する必須名称のグリッド  -->
                            <Grid x:Name="PART_Track">
                                <!--
                                    PART_Indicator: WPF が Value/Maximum に基づいて Width を動的設定する。
                                    Fill を TemplateBinding Foreground にバインドすることで、
                                    各インスタンスで Foreground を指定するだけで色を変えられる。
                                    RadiusX/RadiusY で先端を丸くする。
                                -->
                                <Rectangle
                                    x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Fill="{TemplateBinding Foreground}"
                                    RadiusX="5"
                                    RadiusY="5" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
