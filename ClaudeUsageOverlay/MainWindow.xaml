<Window x:Class="ClaudeUsageOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClaudeUsageOverlay"
        mc:Ignorable="d"
        Title="Claude Usage Overlay"
        Width="460" Height="74"
        MinWidth="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!--
        右クリックメニュー:
        セッションリセット・設定・終了 の操作を提供する
    -->
    <Window.ContextMenu>
        <ContextMenu Background="#2A2A2A" BorderBrush="#484848" Foreground="White">
            <MenuItem Header="設定(_S)" Click="Settings_Click"
                      Background="#2A2A2A" Foreground="White"/>
            <MenuItem Header="ログイン(_L)" Click="Login_Click"
                      Background="#2A2A2A" Foreground="White"/>
            <MenuItem Header="セッションリセット(_R)" Click="ResetSession_Click"
                      Background="#2A2A2A" Foreground="White"/>
            <Separator Background="#484848"/>
            <!-- トレイに隠す（× ボタンと同じ動作） -->
            <MenuItem Header="非表示にする(_H)" Click="Hide_Click"
                      Background="#2A2A2A" Foreground="White"/>
            <Separator Background="#484848"/>
            <MenuItem Header="終了(_X)" Click="Exit_Click"
                      Background="#2A2A2A" Foreground="White"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!--
        最外枠 Border:
        - Background="#1C1C1C" でダークテーマの背景を設定する
        - CornerRadius="8" で丸角にする
        - BorderBrush="#3D3D3D" で微細な縁取りを付ける
    -->
    <Border Background="#1C1C1C"
            CornerRadius="8"
            BorderBrush="#3D3D3D"
            BorderThickness="1">

        <!--
            メインレイアウトグリッド:
            列 0: セッションセクション（広め）
            列 1: 縦区切り線（1px）
            列 2: 週間セクション（狭め）
        -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- メインコンテンツ行 -->
                <RowDefinition Height="*"/>
                <!-- ステータスバー行 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- ステータスバー（最終更新時刻 or エラー） -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   Foreground="#555555"
                   FontSize="9"
                   HorizontalAlignment="Right"
                   Margin="0,0,10,4"/>

        <Grid Grid.Row="0" Margin="14,8">
            <Grid.ColumnDefinitions>
                <!-- セッションセクション: 週間より広いスペースを確保する -->
                <ColumnDefinition Width="5*"/>
                <!-- 縦区切り線 -->
                <ColumnDefinition Width="Auto"/>
                <!-- 週間セクション -->
                <ColumnDefinition Width="3*"/>
                <!-- 更新ボタン -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================================
                 左列: セッションセクション
                 行 0: オレンジ色プログレスバー + 使用率テキスト
                 行 1: スペーサー (4px)
                 行 2: "セッション" ラベル + 残り時間テキスト
                 =================================================== -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 行 0: プログレスバー行 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <!-- バー部分: 利用可能な幅を全て使う -->
                        <ColumnDefinition Width="*"/>
                        <!-- パーセンテージテキスト: 内容に合わせた幅 -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!--
                        セッション プログレスバー（オレンジ）:
                        - Value を SessionPercent (0〜100) にバインドする
                        - Foreground="#FF8C00" でオレンジ色を指定する
                        - RoundProgressBarStyle で丸角スタイルを適用する
                    -->
                    <ProgressBar Grid.Column="0"
                                 Value="{Binding SessionPercent}"
                                 Maximum="100"
                                 Height="11"
                                 Foreground="#FF8C00"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource RoundProgressBarStyle}"/>

                    <!--
                        セッション使用率テキスト（例: "75%"）:
                        オレンジ色・太字で目立たせる
                    -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding SessionPercentText}"
                               Foreground="#FF8C00"
                               FontSize="15"
                               FontWeight="Bold"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- 行 2: ラベル行（"セッション" と 残り時間） -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- "セッション" ラベル -->
                    <TextBlock Grid.Column="0"
                               Text="セッション"
                               Foreground="#888888"
                               FontSize="11"/>

                    <!-- 残り時間テキスト（例: "1時間13分"）: 右寄せ -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding SessionRemainingText}"
                               Foreground="#888888"
                               FontSize="11"/>
                </Grid>
            </Grid>

            <!-- 縦区切り線: セッションと週間を視覚的に分離する -->
            <Rectangle Grid.Column="1"
                       Width="1"
                       Fill="#404040"
                       Margin="0,3"/>

            <!-- ===================================================
                 右列: 週間セクション
                 行 0: グリーンドット + 使用率テキスト
                 行 1: スペーサー (4px)
                 行 2: "週間" ラベル + 残り時間テキスト
                 =================================================== -->
            <Grid Grid.Column="2" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 行 0: グリーンドット + パーセンテージ行 -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!--
                        週間インジケータ（グリーンドット）:
                        使用率が低いことを示す小さな丸いインジケータ。
                        使用率が高くなると色が変わる（黄色・赤）。
                        色の制御は MainWindow.xaml.cs で行う。
                    -->
                    <Ellipse x:Name="WeeklyIndicatorDot"
                             Width="10" Height="10"
                             Fill="#4CAF50"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"/>

                    <!--
                        週間使用率テキスト（例: "5%"）:
                        グリーン色・太字で表示する
                    -->
                    <TextBlock x:Name="WeeklyPercentBlock"
                               Text="{Binding WeeklyPercentText}"
                               Foreground="#4CAF50"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 行 2: ラベル行（"週間" と 残り時間） -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- "週間" ラベル -->
                    <TextBlock Grid.Column="0"
                               Text="週間"
                               Foreground="#888888"
                               FontSize="11"/>

                    <!-- 週間リセットまでの残り時間（例: "6日21時間"）: 右寄せ -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding WeeklyRemainingText}"
                               Foreground="#888888"
                               FontSize="11"/>
                </Grid>
            </Grid>

            <!-- ===================================================
                 右端: 更新ボタン（↺）
                 クリックで claude.ai から最新データを即時取得する
                 =================================================== -->
            <Button x:Name="RefreshButton"
                    Grid.Column="3"
                    Width="22" Height="22"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="今すぐ更新"
                    Click="Refresh_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!--
                            ホバー時に色が変わるシンプルなアイコンボタン。
                            ContentPresenter で ↺ テキストを表示する。
                        -->
                        <Border x:Name="ButtonBorder"
                                Background="Transparent"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <!-- ↺ アイコン（Unicode 回転矢印） -->
                <TextBlock Text="↺"
                           FontSize="16"
                           Foreground="#888888"
                           ToolTip="今すぐ更新"/>
            </Button>

        </Grid>

        </Grid><!-- outer Grid -->
    </Border>
</Window>
