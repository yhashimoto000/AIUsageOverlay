<Window x:Class="ClaudeUsageOverlay.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Claude ログイン - Usage Overlay"
        Width="920" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C1C">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 案内テキスト行 -->
            <RowDefinition Height="Auto"/>
            <!-- WebView2 行 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 案内メッセージ -->
        <TextBlock Grid.Row="0"
                   Text="claude.ai にログインしてください。ログイン完了後、このウィンドウを閉じると自動で使用量が更新されます。"
                   Foreground="#AAAAAA"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="12,10,12,8"/>

        <!-- WebView2 ブラウザ -->
        <wv2:WebView2 x:Name="LoginWebView"
                      Grid.Row="1"/>
    </Grid>
</Window>
